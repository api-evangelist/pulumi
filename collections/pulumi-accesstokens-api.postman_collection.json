          "name": "ListOrgTokens",
          "request": {
            "name": "ListOrgTokens",
            "description": {
              "content": "Retrieves all access tokens created for an organization. Organization tokens provide CI/CD automation access scoped to the organization rather than tied to individual user accounts. The response includes token metadata such as name, description, creation date, last used date, and expiration status. The actual token values are never returned after initial creation. An optional filter parameter can include expired tokens in the results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "orgs",
                ":orgName",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter tokens by status (e.g., include expired tokens)"
                }
              ],
              "variable": [
