            "url": "{{baseUrl}}/api/stacks/:orgName/:projectName/:stackName/deployments/ttl/schedules/:scheduleID",
            "params": [
              {
                "name": "orgName",
                "value": "",
                "type": "path",
                "description": "The organization name"
              },
              {
                "name": "projectName",
                "value": "",
                "type": "path",
                "description": "The project name"
              },
              {
                "name": "stackName",
                "value": "",
                "type": "path",
                "description": "The stack name"
              },
              {
